# Project 1 is the account and primary content project.
NEXT_PUBLIC_SUPABASE_PRIMARY_URL=
NEXT_PUBLIC_SUPABASE_PRIMARY_PUBLISHABLE_KEY=
# Server-only. Used to record one Art or page-content view per browser per day.
SUPABASE_PRIMARY_SECRET_KEY=

# Optional project 2 for content assigned to "secondary" in realms.ts.
NEXT_PUBLIC_SUPABASE_SECONDARY_URL=
NEXT_PUBLIC_SUPABASE_SECONDARY_PUBLISHABLE_KEY=
# Server-only. Required for admin edits in project 2; never add NEXT_PUBLIC_ to this.
SUPABASE_SECONDARY_SECRET_KEY=
